# Copy to .env only when enabling live integrations.
# The app otherwise runs in local demo mode from the bundled CSV and SOP.
Agent_llm=OLLAMA
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

# Required for Pinecone SOP retrieval
PINECONE_API_KEY=

# Required for SQL Server telemetry and audit logging
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional cloud reasoners
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_HOST=
